# Shared team repository (Neon via pylon-webhook-service)
# Provides shared workflows, script library, and live team coverage.
STUDIO_SHARED_SECRET=
STUDIO_LIBRARY_URL=https://pylon-webhook-service.vercel.app/api/studio-beta-scripts

# Required for live Pylon article synchronization and optional article publishing.
PYLON_API_TOKEN=
PYLON_KB_ID=01dbe3ef-3f4e-46d5-ba0f-0cde759181ec

# Optional fallback when Claude CLI is unavailable.
GEMINI_API_KEY=

# Optional — mirrors every rendered video into this Google account's Drive as an "Anyone with the
# link" viewer copy, linked from the Recorded tab. See README.md for the one-time OAuth setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# Narration voice. With a key set, videos are narrated by ElevenLabs (default voice:
# "Matilda"); without one they fall back to the free edge-tts voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional bridge settings.
KBS_BRIDGE_PORT=8787
KBS_PLAN_MODEL=claude-sonnet-5
KBS_DECISION_MODEL=claude-sonnet-5
